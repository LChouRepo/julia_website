---
// Ink sketch of a full concert hall in one-point perspective, seen from the back of the stalls. Few lines on purpose.
// Room coordinates: u across (-1 left … 1 right), Y height (+ = down, floor = FLOOR), d depth (0 near … 1 stage wall).
const W = 1600, H = 640, VX = 800, VY = 250, HALF = 860, FLOOR = 505, CEIL = -380, FAR = .27
const s = d => 1 / (1 + d * (1 / FAR - 1))
const P = (u, Y, d) => [VX + u * HALF * s(d), VY + Y * s(d)]
const f = n => n.toFixed(1)
const pt = (u, Y, d) => P(u, Y, d).map(f).join(',')
const line = (a, b) => `M${pt(...a)} L${pt(...b)}`
const poly = ps => 'M' + ps.map(p => pt(...p)).join(' L') + ' Z'

// room: four receding edges and the stage wall
const room = [
  line([-1, FLOOR, 0], [-1, FLOOR, 1]), line([1, FLOOR, 0], [1, FLOOR, 1]),
  line([-1, CEIL, 0], [-1, CEIL, 1]), line([1, CEIL, 0], [1, CEIL, 1]),
  poly([[-1, CEIL, 1], [1, CEIL, 1], [1, FLOOR, 1], [-1, FLOOR, 1]]),
]
const pilasters = [.12, .3, .52].flatMap(d => [-1, 1].map(u => line([u, FLOOR, d], [u, CEIL, d])))
// stage, music stand, chair
const SD = .76, ST = FLOOR - 150
const stage = poly([[-1, ST, SD], [1, ST, SD], [1, ST, 1], [-1, ST, 1]]) + ' ' + poly([[-1, ST, SD], [1, ST, SD], [1, FLOOR, SD], [-1, FLOOR, SD]])
const [sx, sy] = P(-.07, ST, .84), k0 = s(.84)
const stand = `M${f(sx)},${f(sy)} L${f(sx)},${f(sy - 110 * k0)} M${f(sx - 26 * k0)},${f(sy - 108 * k0)} L${f(sx + 26 * k0)},${f(sy - 122 * k0)} L${f(sx + 24 * k0)},${f(sy - 92 * k0)} L${f(sx - 28 * k0)},${f(sy - 80 * k0)} Z`
const [cx, cy] = P(.08, ST, .86), k1 = s(.86)
const chair = `M${f(cx - 22 * k1)},${f(cy)} L${f(cx - 22 * k1)},${f(cy - 46 * k1)} L${f(cx + 22 * k1)},${f(cy - 46 * k1)} L${f(cx + 22 * k1)},${f(cy)} M${f(cx - 20 * k1)},${f(cy - 46 * k1)} L${f(cx - 18 * k1)},${f(cy - 96 * k1)} L${f(cx + 18 * k1)},${f(cy - 96 * k1)} L${f(cx + 20 * k1)},${f(cy - 46 * k1)}`
const [px, py] = P(0, ST, .85)
// audience: each row is one scalloped line of heads, filled below so nearer rows hide farther ones
const ROWS = 8, rows = []
for (let r = ROWS - 1; r >= 0; r--) {
  const d = .04 + (r / (ROWS - 1)) ** 1.15 * .6, k = s(d), seat = .07, rake = (1 - r / (ROWS - 1)) * 60
  const base = FLOOR - 70 - rake, [x0, y] = P(-.78, base, d), [x1] = P(.78, base, d)
  const n = Math.round(1.56 / seat), step = (x1 - x0) / n, hr = step * .42
  let p = `M${f(x0)},${f(y)}`
  for (let i = 0; i < n; i++) {
    const a = x0 + i * step, gap = (step - hr * 2) / 2, j = Math.sin((i + r * 7) * 12.9) * .12
    p += ` L${f(a + gap)},${f(y)} A${f(hr)},${f(hr * (1.15 + j))} 0 0,1 ${f(a + gap + hr * 2)},${f(y)}`
  }
  p += ` L${f(x1)},${f(y)}`
  rows.push({ line: p, fill: p + ` L${f(x1)},${f(y + 60 * k)} L${f(x0)},${f(y + 60 * k)} Z` })
}
const horizon = `M0,${VY} L${W},${VY}`
---
<figure class="hall hall-ink" aria-label="Ink sketch of a full concert hall seen from the back of the audience">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img">
    <g class="construct">
      <path d={horizon} />
      <path d={`M${VX - 8},${VY} L${VX + 8},${VY} M${VX},${VY - 8} L${VX},${VY + 8}`} />
      <text x={VX + 12} y={VY - 8}>VP</text>
    </g>
    <g class="ink fine">{pilasters.map(p => <path d={p} />)}</g>
    <g class="ink">{room.map(p => <path d={p} />)}</g>
    <path class="ink paper" d={stage} />
    <ellipse class="pool" cx={f(px)} cy={f(py + 4)} rx={f(260 * s(.87))} ry={f(46 * s(.87))} />
    <g class="ink"><path d={stand} /><path d={chair} /></g>
    {rows.map(r => <g class="row"><path class="paper" d={r.fill} /><path class="ink" d={r.line} /></g>)}
  </svg>
  <figcaption><slot /></figcaption>
</figure>
<style>
  .hall-ink{margin:0 0 4vh}
  .hall-ink svg{display:block;width:100%;height:min(40vw,64vh)}
  .hall-ink .ink{fill:none;stroke:var(--ink);stroke-width:1.15;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-linejoin:round}
  .hall-ink .fine{stroke-width:.6;opacity:.7}
  .hall-ink .paper{fill:var(--sand)}
  .hall-ink .pool{fill:var(--red);opacity:.18}
  .hall-ink .construct path{stroke:var(--ink);stroke-width:.5;stroke-dasharray:3 5;opacity:.35;vector-effect:non-scaling-stroke}
  .hall-ink .construct text{font:500 10px "Archivo Narrow";fill:var(--ink);opacity:.45;letter-spacing:.1em}
  @media (max-width:860px){.hall-ink svg{height:62vw}}
</style>
